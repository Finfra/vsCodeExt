{
  "name": "todo-asterisk-bullet",
  "displayName": "Todo Asterisk Bullet",
  "description": "Cycle Markdown todo bullets through 7 states: * [ ] → * [~] → * [v] → * [>] → * [!] → * [x] → * [?] (todo·in progress·done·delegated·on hold·cancelled·unknown) / 마크다운 7단계 순환 토글 (착수전·진행·완료·위임·보류·취소·모름)",
  "version": "0.0.6",
  "publisher": "nowage",
  "readme": "README.md",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:todoAsteriskBullet.toggleState",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "todoAsteriskBullet.toggleState",
        "title": "Toggle Asterisk Bullet State"
      }
    ],
    "keybindings": [
      {
        "command": "todoAsteriskBullet.toggleState",
        "key": "shift+alt+enter",
        "mac": "shift+option+enter",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/toggle.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "typescript": "^4.4.0",
    "tslint": "^6.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Finfra/vsCodeExt/tree/main/todo-asterisk-bullet/vscode"
  },
  "license": "MIT",
  "icon": "images/f.png",
    "badges": [
    {
      "url": "https://img.shields.io/badge/Made%20by-NamJungGu-blue",
      "href": "https://github.com/nowage",
      "description": "Made by NamJungGu"
    },
    {
      "url": "https://img.shields.io/badge/Powered%20by-Finfra%20Co.%2C%20Ltd.-green",
      "href": "https://finfra.kr",
      "description": "Powered by Finfra Co., Ltd"
    }
  ]
}
